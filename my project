function picketFence(x: number, y: number, w: number) {
    for (let fx = x; fx < x + w; fx += 3) {
        bg.fillRect(fx, y, 2, 7, C_TAN)
        bg.setPixel(fx, y - 1, C_TAN)
    }
    bg.fillRect(x, y + 2, w, 1, C_BROWN)
    bg.fillRect(x, y + 5, w, 1, C_BROWN)
