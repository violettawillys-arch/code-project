}

// Redraw the whole battle interface onto the transparent `ui` sprite.
function drawUI() {
    let img = image.create(160, 120)

    // Creature name and health bar (top right)
    if (inBattle && foe != null) {
        img.print(foe.name, 100, 4, C_WHITE)
        img.drawRect(100, 14, 56, 6, C_WHITE)
        let w = Math.idiv(54 * foe.hp, foe.maxHp)
        if (w > 0) {
            img.fillRect(101, 15, w, 4, C_GREEN)
        }
    }

    // FIGHT / UNDERSTAND / MERCY list, or the UNDERSTAND options
    if (mode == GameMode.Menu || mode == GameMode.Understand) {
        img.fillRect(0, 76, 160, 44, C_BLACK)
        img.drawRect(0, 76, 160, 44, C_WHITE)
        for (let i = 0; i < menuItems.length; i++) {
            let y = 80 + i * 10
            let col = C_WHITE
            if (mode == GameMode.Menu && i == 2) {
                if (canMercy) {
                    col = C_GREEN       // green = MERCY is available
                } else {
                    col = C_LILAC       // dusty = locked
                }
            }
            if (i == menuIndex) {
                img.print(">", 6, y, C_YELLOW)
                if (col == C_WHITE) {
                    col = C_YELLOW
                }
            }
            img.print(menuItems[i], 16, y, col)
        }
    }

    // Timing bar: red = miss, green = hit, yellow = critical
    if (mode == GameMode.Timing) {
        img.fillRect(0, 76, 160, 44, C_BLACK)
        img.drawRect(0, 76, 160, 44, C_WHITE)
        img.print("Press A to strike!", 20, 80, C_WHITE)
        img.fillRect(BAR_LEFT, 96, BAR_RIGHT - BAR_LEFT, 12, C_RED)
        img.fillRect(BAR_CENTRE - HIT_RANGE, 96, HIT_RANGE * 2, 12, C_GREEN)
        img.fillRect(BAR_CENTRE - CRIT_RANGE, 96, CRIT_RANGE * 2, 12, C_YELLOW)
        img.drawRect(BAR_LEFT, 96, BAR_RIGHT - BAR_LEFT, 12, C_WHITE)
    }

    // Dodge arena
    if (mode == GameMode.Dodge) {
        img.drawRect(48, 56, 64, 44, C_WHITE)
        img.print("DODGE!", 64, 106, C_RED)
    }

    ui.setImage(img)
}

// Show the main menu with the cursor on row `selected`.
function returnToMenu(selected: number) {
    menuItems = ["FIGHT", "UNDERSTAND", "MERCY"]
    menuIndex = selected
    mode = GameMode.Menu
    drawUI()
}

// Called from the exploration loop when Lancer reaches a creature.
function beginEncounter(c: Creature) {
    enterCutscene()
    control.runInParallel(function () {
        foe = c
        talk(c.introLines)
        // Switch to the battle screen
        inBattle = true
        canMercy = false
        c.hp = c.maxHp
        setWorldVisible(false)
        c.sprite.setFlag(SpriteFlag.Invisible, false)
        c.sprite.setImage(enlarge(c.img))
        c.sprite.setPosition(80, 34)
        scene.setBackgroundImage(makeBattleBg(c.mapIndex))
        returnToMenu(0)
    })
}

// Leave the battle screen and go back to exploring.
function endEncounter() {
    inBattle = false
    canMercy = false
    if (foe.state == 2) {
        foe.sprite.destroy()
        foe.sprite = null
    } else {
        // A spared creature steps aside and becomes a harmless NPC.
        foe.sprite.setImage(foe.img)
        foe.sprite.setKind(SpriteKind.NPC)
        foe.sprite.setPosition(foe.restX, foe.restY)
    }
    scene.setBackgroundImage(bg)
    setWorldVisible(true)
    info.setLife(START_LIFE)          // heal between encounters
    ui.setImage(image.create(160, 120))
    mode = GameMode.Explore
}

// ----- Menu input -----
function moveCursor(step: number) {
    if (mode != GameMode.Menu && mode != GameMode.Understand) {
        return
    }
    menuIndex = (menuIndex + step + menuItems.length) % menuItems.length
    drawUI()
}

function confirmMenu() {
    let choice = menuIndex
    mode = GameMode.Cutscene          // lock input while the action plays
    if (choice == 0) {
        startTiming()
    } else if (choice == 1) {
        menuItems = foe.options
        menuIndex = 0
        mode = GameMode.Understand
        drawUI()
    } else if (canMercy) {
        spareFoe()
    } else {
        sfxBad()
        drawUI()
        talk(["Lancer doesn't understand " + foe.name + " well enough to end this peacefully."])
        returnToMenu(2)
    }
}

function confirmUnderstand() {
    let opt = menuIndex
    mode = GameMode.Cutscene
    drawUI()
    doUnderstand(foe, opt)
}

// MERCY: only reachable once canMercy is true.
function spareFoe() {
    sfxGood()
    foe.state = 1
    talk(foe.spareLines)
    endEncounter()
}

// ----- UNDERSTAND logic: every creature needs different actions -----
// flagA / flagB are the two steps each creature needs. MERCY unlocks
// when both are true.
function doUnderstand(c: Creature, opt: number) {
    let wasUnlocked = canMercy
    let hostile = false      // true = the creature retaliates

    if (c.id == 0) {
        // TARN the Frightened Guard. Needs: lower sword, THEN explain.
        if (opt == 0) {
            talk(["LANCER: Step aside, or I'll make you.", "TARN: I knew it! Keep away from me!"])
            c.flagA = false
            c.flagB = false
            hostile = true
        } else if (opt == 1) {
            if (!c.flagA) {
                talk(["LANCER: I'm looking for Princess Noelle. I mean no harm.", "TARN: Easy words... from someone holding a sword."])
            } else if (!c.flagB) {
                talk(["LANCER: I'm looking for Princess Noelle. I mean no harm.", "TARN: Noelle? You're not here to attack us?", "TARN: I only saw the sword. I was afraid."])
                c.flagB = true
            } else {
                talk(["TARN: You've already explained. ...Thank you."])
            }
        } else {
            if (!c.flagA) {
                talk(["(You lower your sword.)", "TARN: ...What are you doing?"])
                c.flagA = true
            } else {
                talk(["(Your sword is already lowered.)"])
            }
        }
    } else if (c.id == 1) {
        // MOSS the Hungry Creature. Needs: ask what is wrong AND offer food.
        if (opt == 0) {
            talk(["LANCER: Out of my way, you filthy little thing.", "MOSS: ...Grrrr!"])
            hostile = true
        } else if (opt == 1) {
            if (!c.flagA) {
                talk(["LANCER: Are you all right?", "MOSS: ...Haven't eaten. Not in days.", "(Its eyes dart to your bag again.)"])
                c.flagA = true
            } else {
                talk(["MOSS: I told you. ...Still hungry."])
            }
        } else {
            if (c.flagB) {
                talk(["(Moss already has food.)"])
            } else if (!hasBread) {
                talk(["(You have nothing to offer.)"])
            } else {
                talk(["LANCER: Here. Take it.", "MOSS: ...For me? Really?", "(Moss eats quickly, then slows down. Its shoulders relax.)"])
                hasBread = false
                c.flagB = true
            }
        }
    } else {
        // WREN the Lonely Ghost. Needs: ask its name, THEN listen.
        if (opt == 0) {
            talk(["LANCER: Move. I need to cross.", "WREN: ...Everyone says that."])
            hostile = true
        } else if (opt == 1) {
            talk(["(You look past the ghost as if it isn't there.)", "WREN: Don't... don't leave!"])
            hostile = true
        } else if (opt == 2) {
            if (!c.flagA) {
                talk(["LANCER: What's your name?", "WREN: ...Wren. Nobody has asked in so long.", "(The air feels a little warmer.)"])
                c.flagA = true
            } else {
                talk(["WREN: I'm Wren. ...Thank you for remembering."])
            }
        } else {
            if (!c.flagA) {
                talk(["(Wren whispers something. You can't quite hold onto it.)"])
            } else if (!c.flagB) {
                talk(["(You stay quiet and listen.)", "WREN: This bridge used to be so busy. Everyone stopped to say goodbye.", "WREN: Then they stopped coming. ...Nobody says goodbye anymore.", "(Wren seems lighter.)"])
                c.flagB = true
            } else {
                talk(["(Wren hums quietly. You listen a little longer.)"])
            }
        }
    }

    canMercy = c.flagA && c.flagB
    if (hostile) {
        dodgePhase(c)
    }
    if (canMercy && !wasUnlocked) {
        sfxGood()
        talk([c.unlockLine])
    }
    returnToMenu(1)
}

// ----- FIGHT: timing bar -----
function startTiming() {
    mode = GameMode.Timing
    drawUI()
    marker = sprites.create(markerImg, SpriteKind.Marker)
    marker.z = 101
    marker.setPosition(BAR_LEFT, 102)
    marker.vx = foe.barSpeed
}

// Called when A is pressed in Timing mode. Distance from the centre of
// the bar decides the damage.
function strike() {
    mode = GameMode.Cutscene
    marker.vx = 0
    let off = Math.abs(marker.x - BAR_CENTRE)
    let dmg = 0
    let label = "MISS"
    if (off <= CRIT_RANGE) {
        dmg = 3
        label = "CRITICAL!"
    } else if (off <= HIT_RANGE) {
        dmg = 2
        label = "HIT"
    }
    if (dmg > 0) {
        foe.hp = Math.max(0, foe.hp - dmg)
        sfxHit()
        scene.cameraShake(4, 250)
        foe.sprite.sayText(label + " -" + convertToText(dmg), 800)
    } else {
        sfxBad()
        foe.sprite.sayText(label, 800)
    }
    drawUI()
    pause(900)
    marker.destroy()
    marker = null
    if (foe.hp <= 0) {
        // ROUTE TRACKING: record the kill. The game does not comment on
        // it now. The consequences appear in the ending.
        kills += 1
        foe.state = 2
        talk(foe.deathLines)
        endEncounter()
    } else {
        dodgePhase(foe)
        returnToMenu(0)
    }
}

// ----- Enemy retaliation: a short dodge sequence -----
function spawnProjectile(c: Creature) {
    let p = sprites.create(makeBullet(c.id), SpriteKind.Projectile)
    if (c.id == 0) {
        // Tarn throws spears straight down
        p.setPosition(randint(52, 108), 58)
        p.setVelocity(0, 55)
    } else if (c.id == 1) {
        // Moss snaps in from the sides
        if (randint(0, 1) == 0) {
            p.setPosition(50, randint(61, 97))
            p.setVelocity(60, 0)
        } else {
            p.setPosition(110, randint(61, 97))
            p.setVelocity(-60, 0)
        }
    } else {
        // Wren's wisps drift toward the heart
        let px = randint(52, 108)
        p.setPosition(px, 58)
        p.setVelocity(Math.idiv((heart.x - px) * 7, 10), Math.idiv((heart.y - 58) * 7, 10))
    }
}

function dodgePhase(c: Creature) {
    mode = GameMode.Dodge
    drawUI()
    heart = sprites.create(heartImg, SpriteKind.Heart)
    heart.z = 102
    heart.setPosition(80, 80)
    let elapsed = 0
    while (elapsed < c.dodgeMs) {
        spawnProjectile(c)
        pause(c.spawnMs)
        elapsed += c.spawnMs
    }
    pause(700)
    for (let p of sprites.allOfKind(SpriteKind.Projectile)) {
        p.destroy()
    }
    heart.destroy()
    heart = null
    mode = GameMode.Cutscene
    drawUI()
}

// Runs every frame during the timing bar.
function timingFrame() {
    if (marker == null) {
        return
    }
    if (marker.x >= BAR_RIGHT) {
        marker.vx = -Math.abs(marker.vx)
    }
    if (marker.x <= BAR_LEFT) {
        marker.vx = Math.abs(marker.vx)
    }
}

// Runs every frame during the dodge phase.
function dodgeFrame() {
    if (heart == null) {
        return
    }
    heart.vx = controller.dx(HEART_SPEED)
    heart.vy = controller.dy(HEART_SPEED)
    heart.x = Math.max(52, Math.min(108, heart.x))
    heart.y = Math.max(60, Math.min(96, heart.y))
    for (let p of sprites.allOfKind(SpriteKind.Projectile)) {
        if (p.x < 46 || p.x > 114 || p.y < 54 || p.y > 102) {
            p.destroy()
        }
    }
}


// ---------------------------------------------------------------------
// 9. ENDINGS (decided by the `kills` counter)
// ---------------------------------------------------------------------

function runEnding() {
    mode = GameMode.Ending
    if (kills == 0) {
        // GOOD ENDING: nobody was killed.
        talk([
            "LANCER: Princess Noelle! You're safe!",
            "NOELLE: Of course I'm safe. No one took me, Lancer.",
            "NOELLE: These are my people. Tarn, Moss and Wren have already told me about the road.",
            "LANCER: I thought they were monsters.",
            "NOELLE: A lot of people do, at first.",
            "NOELLE: You came here believing you had to be a hero.",
            "NOELLE: But when you had every reason to fear us... you chose to understand.",
            "NOELLE: That's what made you one."
        ])
        game.setGameOverMessage(true, "That's what made you one.")
        game.over(true)
    } else {
        // BAD ENDING: one or more creatures were killed.
        let missing = ""
        let count = 0
        for (let c of cast) {
            if (c.state == 2) {
                if (count > 0) {
                    missing = missing + ", "
                }
                missing = missing + c.name
                count += 1
            }
        }
        talk([
            "(The great hall is quiet. Too quiet.)",
            "LANCER: Princess Noelle! You're safe!",
            "NOELLE: Safe? No one took me, Lancer.",
            "NOELLE: Everyone you met on the road was one of my people.",
            "NOELLE: I was still waiting for: " + missing + ".",
            "NOELLE: You came here to save one person.",
            "NOELLE: How many did you decide didn't deserve saving?",
            "NOELLE: You reached the princess.",
            "NOELLE: But did you become the hero?"
        ])
        game.setGameOverMessage(false, "You reached the princess. But you never became the hero.")
        game.over(false)
    }
}


// ---------------------------------------------------------------------
// 10. CONTROLLER EVENTS AND THE PER-FRAME UPDATE
// ---------------------------------------------------------------------

controller.up.onEvent(ControllerButtonEvent.Pressed, function () {
    moveCursor(-1)
})

controller.down.onEvent(ControllerButtonEvent.Pressed, function () {
    moveCursor(1)
})

controller.A.onEvent(ControllerButtonEvent.Pressed, function () {
    if (mode == GameMode.Explore) {
        inspectNearby()
    } else if (mode == GameMode.Menu) {
        confirmMenu()
    } else if (mode == GameMode.Understand) {
        confirmUnderstand()
    } else if (mode == GameMode.Timing) {
        strike()
    }
})

controller.B.onEvent(ControllerButtonEvent.Pressed, function () {
    if (mode == GameMode.Understand) {
        returnToMenu(1)
    }
})

// Heart hit by a projectile: lose one life, with a short invincibility.
sprites.onOverlap(SpriteKind.Heart, SpriteKind.Projectile, function (sprite, otherSprite) {
    otherSprite.destroy()
    if (game.runtime() - lastHit > 900) {
        lastHit = game.runtime()
        info.changeLifeBy(-1)
        sfxHit()
        scene.cameraShake(3, 200)
    }
})

game.onUpdate(function () {
    if (mode == GameMode.Explore) {
        exploreFrame()
    } else if (mode == GameMode.Timing) {
        timingFrame()
    } else if (mode == GameMode.Dodge) {
        dodgeFrame()
    }
    if (lancer != null) {
        animateLancer()
    }
})


