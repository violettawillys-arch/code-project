function hedge(x: number, y: number, w: number, h: number) {
    bg.fillRect(x, y, w, h, C_TEAL)
    speckle(x, y, w, h, C_GREEN, Math.idiv(w * h, 3))
    bg.drawRect(x, y, w, h, C_PLUM)
}

// A full moon with a soft edge and craters.
function moon(cx: number, cy: number, r: number) {
    for (let dx = -r; dx <= r; dx++) {
        for (let dy = -r; dy <= r; dy++) {
            let d = dx * dx + dy * dy
            if (d <= r * r) {
                let col = C_WHITE
                if (d > (r - 1) * (r - 1)) {
                    col = C_SKY
                }
                bg.setPixel(cx + dx, cy + dy, col)
            }
        }
    }
    bg.setPixel(cx - 2, cy - 1, C_LILAC)
    bg.setPixel(cx - 1, cy - 1, C_LILAC)
    bg.setPixel(cx + 2, cy + 2, C_LILAC)
    bg.setPixel(cx + 1, cy - 3, C_LILAC)
}

// A pine-tree silhouette (a stack of widening rows).
function pine(x: number, baseY: number, h: number, col: number) {
    for (let i = 0; i < h; i++) {
        let half = Math.idiv(i, 3)
        bg.fillRect(x - half, baseY - h + i, 1 + half * 2, 1, col)
    }
    bg.fillRect(x, baseY, 1, 2, col)
}

function addNote(x: number, y: number, text: string) {
    notes.push(new MapNote(x, y, text))
}

function addExit(x: number, y: number, w: number, h: number, target: number, spawnX: number, spawnY: number) {
    exits.push(new MapExit(x, y, w, h, target, spawnX, spawnY))
}


