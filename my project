// A dark, themed backdrop for the battle screen.
function makeBattleBg(index: number): Image {
    let b = image.create(160, 120)
    b.fill(C_BLACK)
    for (let i = 0; i < 30; i++) {
        b.setPixel(randint(0, 159), randint(0, 40), C_WHITE)
    }
    if (index == 1) {
        // forest dusk: layers of pines
        for (let x = 0; x < 160; x += 7) {
            let h = randint(14, 24)
            for (let i = 0; i < h; i++) {
                let half = Math.idiv(i, 3)
                b.fillRect(x - half, 76 - h + i, 1 + half * 2, 1, C_PLUM)
            }
        }
        for (let x = 3; x < 160; x += 11) {
            let h = randint(10, 18)
            for (let i = 0; i < h; i++) {
                let half = Math.idiv(i, 3)
                b.fillRect(x - half, 76 - h + i, 1 + half * 2, 1, C_TEAL)
            }
        }
    } else if (index == 2) {
        // village at night: lit windows
        for (let x = 4; x < 160; x += 26) {
            b.fillRect(x, 56, 20, 20, C_PLUM)
            b.fillRect(x - 2, 50, 24, 6, C_BROWN)
            b.fillRect(x + 4, 62, 4, 4, C_YELLOW)
            b.fillRect(x + 12, 62, 4, 4, C_YELLOW)
        }
    } else {
        // bridge: moon and water
        b.fillRect(124, 8, 14, 14, C_WHITE)
        b.fillRect(122, 10, 18, 10, C_WHITE)
        b.fillRect(0, 58, 160, 18, C_BLUE)
        for (let i = 0; i < 24; i++) {
            let rx = randint(0, 150)
            let ry = randint(59, 74)
            b.drawLine(rx, ry, rx + 6, ry, C_SKY)
        }
        b.fillRect(0, 54, 160, 3, C_LILAC)
    }
    b.drawRect(0, 0, 160, 120, C_PLUM)
    return b
}



// 7. MAP MANAGEMENT AND THE EXPLORATION LOOP


// Remove every sprite that belongs to the old map.
function clearWorldSprites() {
    let kinds = [SpriteKind.NPC, SpriteKind.Enemy, SpriteKind.Pickup]
    for (let k of kinds) {
        for (let s of sprites.allOfKind(k)) {
            s.destroy()
        }
    }
    for (let c of cast) {
        c.sprite = null
    }
    bread = null
}

// Hide or show every world sprite (used when the battle screen opens).
function setWorldVisible(visible: boolean) {
    let kinds = [SpriteKind.NPC, SpriteKind.Enemy, SpriteKind.Pickup, SpriteKind.Player]
    for (let k of kinds) {
        for (let s of sprites.allOfKind(k)) {
            s.setFlag(SpriteFlag.Invisible, !visible)
        }
    }
}

// Build a map, place Lancer and spawn whatever belongs there.
function changeMap(index: number, sx: number, sy: number) {
    clearWorldSprites()
    mapIndex = index
    walls = []
    exits = []
    notes = []
    bg = image.create(160, 120)
    if (index == 0) {
        buildThroneRoom()
    } else if (index == 1) {
        buildForest()
    } else if (index == 2) {
        buildVillage()
    } else if (index == 3) {
        buildBridge()
    } else if (index == 4) {
        buildCastleGrounds()
    } else {
        buildCastleHall()
    }
    scene.setBackgroundImage(bg)
    lancer.setPosition(sx, sy)
    lastGoodX = sx
    lastGoodY = sy

    // Creatures that are still waiting on this map block the road.
    for (let c of cast) {
        if (c.mapIndex == index && c.state == 0) {
            c.sprite = sprites.create(c.img, SpriteKind.Enemy)
            c.sprite.setPosition(c.worldX, c.worldY)
        }
    }
    // The loaf lies on a little table in the village.
    if (index == 2 && !breadTaken) {
        bread = sprites.create(breadImg, SpriteKind.Pickup)
        bread.setPosition(39, 56)
    }
    // In the castle hall: Noelle, plus every creature that was spared.
    if (index == 5) {
        let noelle = sprites.create(makeNoelleImage(), SpriteKind.NPC)
        noelle.setPosition(80, 32)
        for (let c of cast) {
            if (c.state == 1) {
                let guest = sprites.create(c.img, SpriteKind.NPC)
                guest.setPosition(c.hallX, c.hallY)
            }
        }
    }
}

// Briefly show the name of a new area at the top of the screen.
function showAreaTitle(index: number) {
    areaToken += 1
    let token = areaToken
    let name = AREA_NAMES[index]
    let img = image.create(160, 120)
    let w = name.length * 6 + 12
    let x = 80 - Math.idiv(w, 2)
    img.fillRect(x, 4, w, 14, C_BLACK)
    img.drawRect(x, 4, w, 14, C_YELLOW)
    img.print(name, x + 6, 7, C_WHITE)
    ui.setImage(img)
    pause(1400)
    if (token == areaToken && mode == GameMode.Explore && !inBattle) {
        ui.setImage(image.create(160, 120))
    }
}

// Stop Lancer and lock input (call from Explore mode before any dialogue).
function enterCutscene() {
    mode = GameMode.Cutscene
    lancer.vx = 0
    lancer.vy = 0
}

// Show several dialogue boxes in a row.
function talk(lines: string[]) {
    for (let line of lines) {
        game.showLongText(line, DialogLayout.Bottom)
    }
}

// Does Lancer's feet box at (cx, cy) overlap any wall?
function blocked(cx: number, cy: number): boolean {
    let left = cx - 4
    let top = cy + 3
    for (let w of walls) {
        if (left < w[0] + w[2] && left + 8 > w[0] && top < w[1] + w[3] && top + 5 > w[1]) {
            return true
        }
    }
    return false
}

// Walking animation: face the direction of travel and swap leg frames.
function animateLancer() {
    if (lancer.vx < 0) {
        facing = -1
    } else if (lancer.vx > 0) {
        facing = 1
    }
    if (lancer.vx != 0 || lancer.vy != 0) {
        walkTimer += 1
    } else {
        walkTimer = 0
    }
    let frame = Math.idiv(walkTimer, 6) % 2
    let pick = frame
    if (facing < 0) {
        pick = frame + 2
    }
    let wanted = lancerImgs[pick]
    if (wanted != lancerCurrent) {
        lancer.setImage(wanted)
        lancerCurrent = wanted
    }
}

// Move to another map. Runs in its own fiber so it may pause.
function useExit(e: MapExit) {
    enterCutscene()
    control.runInParallel(function () {
        changeMap(e.target, e.spawnX, e.spawnY)
        mode = GameMode.Explore
        showAreaTitle(e.target)
    })
}

function pickUpBread() {
    enterCutscene()
    bread.destroy()
    bread = null
    hasBread = true
    breadTaken = true
    control.runInParallel(function () {
        sfxGood()
        talk(["You found a loaf of bread. It is still warm."])
        mode = GameMode.Explore
    })
}

// The note text may depend on what has already happened.
function noteText(n: MapNote): string {
    if (n.needs >= 0 && cast[n.needs].state == 0) {
        return n.lockedText
    }
    return n.text
}

// A pressed in Explore mode: read the nearest sign or object.
function inspectNearby() {
    for (let n of notes) {
        if (Math.abs(lancer.x - n.x) < 20 && Math.abs(lancer.y - n.y) < 22) {
            enterCutscene()
            talk([noteText(n)])
            mode = GameMode.Explore
            return
        }
    }
}

// Runs every frame while exploring.
function exploreFrame() {
    // 1. Movement from the D-pad
    lancer.vx = controller.dx(WALK_SPEED)
    lancer.vy = controller.dy(WALK_SPEED)

    // 2. Wall collision: if the new position is inside a wall, slide
    //    along it or go back to the last good position.
    if (blocked(lancer.x, lancer.y)) {
        if (!blocked(lastGoodX, lancer.y)) {
            lancer.x = lastGoodX
        } else if (!blocked(lancer.x, lastGoodY)) {
            lancer.y = lastGoodY
        } else {
            lancer.x = lastGoodX
            lancer.y = lastGoodY
        }
    }
    lastGoodX = lancer.x
    lastGoodY = lancer.y

    // 3. Map exits
    for (let e of exits) {
        if (lancer.x >= e.x && lancer.x < e.x + e.w && lancer.y >= e.y && lancer.y < e.y + e.h) {
            useExit(e)
            return
        }
    }

    // 4. Walking up to Noelle starts the ending
    if (mapIndex == 5 && lancer.y < 62) {
        enterCutscene()
        control.runInParallel(function () {
            runEnding()
        })
        return
    }

    // 5. Bread pickup. The radius is big enough that Lancer cannot walk
    //    past the loaf anywhere along the width of the road.
    if (bread != null && Math.abs(lancer.x - bread.x) < 14 && Math.abs(lancer.y - bread.y) < 18) {
        pickUpBread()
        return
    }

    // 6. Walking close to an unresolved creature starts an encounter
    for (let c of cast) {
        if (c.state == 0 && c.sprite != null && c.mapIndex == mapIndex) {
            if (Math.abs(lancer.x - c.sprite.x) < 20 && Math.abs(lancer.y - c.sprite.y) < 20) {
                beginEncounter(c)
                return
            }
        }
    }
}


