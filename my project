// A rectangle on the map that moves Lancer to another map.
class MapExit {
    x: number
    y: number
    w: number
    h: number
    target: number   // index of the map to load
    spawnX: number   // where Lancer appears on the new map
    spawnY: number
    constructor(x: number, y: number, w: number, h: number, target: number, spawnX: number, spawnY: number) {
        this.x = x
        this.y = y
        this.w = w
        this.h = h
        this.target = target
        this.spawnX = spawnX
        this.spawnY = spawnY
    }
}

// Something Lancer can read by standing close and pressing A.
// This is how the world tells its story without long dialogue.
class MapNote {
    x: number
    y: number
    text: string
    lockedText: string   // shown instead of text until creature `needs` is resolved
    needs: number        // creature index (-1 = always show text)
    constructor(x: number, y: number, text: string) {
        this.x = x
        this.y = y
        this.text = text
        this.lockedText = ""
        this.needs = -1
    }
}

// One creature Lancer can meet. Each has its own problem and solution.
class Creature {
    id: number           // 0 = Tarn (guard), 1 = Moss (hungry), 2 = Wren (ghost)
    name: string
    maxHp: number
    hp: number
    img: Image
    sprite: Sprite
    state: number        // 0 = unresolved, 1 = spared, 2 = killed
    mapIndex: number     // which map the creature waits on
    worldX: number       // where it stands blocking the path
    worldY: number
    restX: number        // where it stands after being spared
    restY: number
    hallX: number        // where it appears in the castle if spared
    hallY: number
    flagA: boolean       // first understanding step done
    flagB: boolean       // second understanding step done
    barSpeed: number     // how fast the timing marker moves
    dodgeMs: number      // how long its retaliation lasts
    spawnMs: number      // how often it fires a projectile
    options: string[]    // its UNDERSTAND menu
    introLines: string[]
    unlockLine: string
    spareLines: string[]
    deathLines: string[]
    constructor(id: number, name: string, maxHp: number, img: Image, mapIndex: number) {
        this.id = id
        this.name = name
        this.maxHp = maxHp
        this.hp = maxHp
        this.img = img
        this.sprite = null
        this.state = 0
        this.mapIndex = mapIndex
        this.worldX = 0
        this.worldY = 0
        this.restX = 0
        this.restY = 0
