// Pixel lookup that returns 0 (transparent) outside the picture.
function pixelAt(src: Image, x: number, y: number): number {
    if (x < 0 || y < 0 || x >= src.width || y >= src.height) {
        return 0
    }
    return src.getPixel(x, y)
}

// Adds a black outline around every opaque shape in a sprite.
function outlined(src: Image): Image {
    let o = image.create(src.width, src.height)
    for (let x = 0; x < src.width; x++) {
        for (let y = 0; y < src.height; y++) {
            let c = src.getPixel(x, y)
            if (c == 0) {
                if (pixelAt(src, x - 1, y) != 0 || pixelAt(src, x + 1, y) != 0 || pixelAt(src, x, y - 1) != 0 || pixelAt(src, x, y + 1) != 0) {
                    c = C_BLACK
                }
            }
            o.setPixel(x, y, c)
        }
    }
    return o
}

// Mirrors a sprite left-to-right (used for Lancer facing left).
function mirror(src: Image): Image {
    let m = image.create(src.width, src.height)
    for (let x = 0; x < src.width; x++) {
        for (let y = 0; y < src.height; y++) {
            m.setPixel(src.width - 1 - x, y, src.getPixel(x, y))
        }
    }
    return m
}

// Doubles a sprite so creatures look bigger on the battle screen.
// Loops over every pixel and paints it as a 2x2 block.
function enlarge(src: Image): Image {
    let big = image.create(src.width * 2, src.height * 2)
    for (let x = 0; x < src.width; x++) {
        for (let y = 0; y < src.height; y++) {
            big.fillRect(x * 2, y * 2, 2, 2, src.getPixel(x, y))
        }
    }
    return big
}

// A generic person. `step` (0 or 1) moves the legs for a walking cycle.
function makePerson(hair: number, skin: number, cloth: number, trim: number, crowned: boolean, step: number): Image {
    let p = image.create(16, 16)
    p.fillRect(5, 2, 6, 5, skin)          // head
    p.fillRect(5, 1, 6, 2, hair)          // hair or helmet
    p.fillRect(4, 2, 1, 3, hair)
    p.fillRect(11, 2, 1, 3, hair)
    if (crowned) {
        p.fillRect(5, 0, 6, 2, C_YELLOW)  // gold crown
        p.setPixel(5, 0, 0)
        p.setPixel(7, 0, 0)
        p.setPixel(10, 0, 0)
    }
    p.setPixel(6, 4, C_BLACK)             // eyes
    p.setPixel(9, 4, C_BLACK)
    p.fillRect(4, 7, 8, 6, cloth)         // body
    p.fillRect(3, 7, 1, 4, cloth)         // arms
    p.fillRect(12, 7, 1, 4, cloth)
    p.fillRect(3, 11, 1, 1, skin)         // hands
    p.fillRect(12, 11, 1, 1, skin)
    p.fillRect(5, 7, 6, 1, trim)          // collar
    p.fillRect(4, 11, 8, 1, trim)         // belt
    if (step == 0) {
        p.fillRect(5, 13, 2, 3, C_PLUM)   // legs together
        p.fillRect(9, 13, 2, 3, C_PLUM)
        p.fillRect(5, 15, 2, 1, C_BROWN)
        p.fillRect(9, 15, 2, 1, C_BROWN)
    } else {
        p.fillRect(4, 13, 2, 3, C_PLUM)   // legs apart
        p.fillRect(10, 13, 2, 3, C_PLUM)
        p.fillRect(4, 15, 2, 1, C_BROWN)
        p.fillRect(10, 15, 2, 1, C_BROWN)
    }
    return p
}

// Lancer: blue tunic, red cape, sword on his right.
function makeLancerFrame(step: number): Image {
    let l = makePerson(C_BROWN, C_TAN, C_BLUE, C_YELLOW, false, step)
    l.fillRect(2, 8, 2, 6, C_RED)         // cape
    l.fillRect(13, 4, 1, 8, C_WHITE)      // sword blade
    l.fillRect(12, 11, 3, 1, C_YELLOW)    // sword guard
    return outlined(l)
}

function makeKingImage(): Image {
    let k = makePerson(C_WHITE, C_TAN, C_PURPLE, C_WHITE, true, 0)
    k.fillRect(3, 12, 10, 4, C_PURPLE)    // long robe
    k.fillRect(3, 15, 10, 1, C_WHITE)     // ermine hem
    k.fillRect(5, 6, 6, 3, C_WHITE)       // beard
    k.fillRect(5, 7, 6, 1, C_WHITE)
    return outlined(k)
}

function makeNoelleImage(): Image {
    let n = makePerson(C_YELLOW, C_TAN, C_PINK, C_WHITE, true, 0)
    n.fillRect(3, 11, 10, 5, C_PINK)      // long skirt
    n.fillRect(3, 15, 10, 1, C_WHITE)
    n.fillRect(4, 5, 1, 5, C_YELLOW)      // long hair
    n.fillRect(11, 5, 1, 5, C_YELLOW)
    return outlined(n)
}

function makeGuardImage(): Image {
    let g = makePerson(C_LILAC, C_TAN, C_BLUE, C_WHITE, false, 0)
    g.fillRect(4, 1, 8, 3, C_LILAC)       // steel helmet
    g.fillRect(7, 3, 2, 3, C_LILAC)       // nose guard
    g.fillRect(1, 2, 1, 14, C_BROWN)      // spear shaft
    g.fillRect(0, 0, 3, 2, C_WHITE)       // spear tip
    return outlined(g)
}

function makeMossImage(): Image {
    let m = image.create(16, 16)
    m.fillRect(3, 4, 10, 10, C_GREEN)     // body
    m.fillRect(3, 1, 3, 4, C_GREEN)       // ears
    m.fillRect(10, 1, 3, 4, C_GREEN)
    m.fillRect(4, 2, 1, 2, C_PINK)
    m.fillRect(11, 2, 1, 2, C_PINK)
    m.fillRect(6, 9, 4, 4, C_YELLOW)      // belly
    m.fillRect(5, 6, 2, 2, C_WHITE)       // eyes
    m.fillRect(9, 6, 2, 2, C_WHITE)
    m.setPixel(6, 7, C_BLACK)
    m.setPixel(10, 7, C_BLACK)
    m.fillRect(4, 14, 3, 2, C_TEAL)       // feet
    m.fillRect(9, 14, 3, 2, C_TEAL)
    return outlined(m)
}

function makeWrenImage(): Image {
    let w = image.create(16, 16)
    w.fillRect(4, 1, 8, 1, C_WHITE)       // rounded head
    w.fillRect(3, 2, 10, 11, C_WHITE)     // body
    w.fillRect(11, 3, 1, 8, C_SKY)        // pale blue shading
    for (let x = 3; x < 13; x++) {        // ragged hem
        if (x % 2 == 0) {
            w.fillRect(x, 13, 1, 3, C_WHITE)
        } else {
            w.fillRect(x, 13, 1, 2, C_SKY)
        }
    }
    w.fillRect(5, 6, 2, 3, C_BLACK)       // eyes
    w.fillRect(9, 6, 2, 3, C_BLACK)
    w.fillRect(7, 10, 2, 1, C_BLACK)      // mouth
    return outlined(w)
}

function makeHeartImage(): Image {
    let h = image.create(5, 5)
    h.fillRect(0, 1, 5, 2, C_RED)
    h.setPixel(1, 0, C_RED)
    h.setPixel(3, 0, C_RED)
    h.fillRect(1, 3, 3, 1, C_RED)
    h.setPixel(2, 4, C_RED)
    h.setPixel(1, 1, C_PINK)
    return h
}

function makeMarkerImage(): Image {
    let m = image.create(4, 16)
    m.fill(C_WHITE)
    m.drawRect(0, 0, 4, 16, C_BLACK)
    return m
}

function makeBreadImage(): Image {
    let b = image.create(8, 6)
    b.fillRect(0, 1, 8, 5, C_ORANGE)
    b.drawRect(0, 1, 8, 5, C_BROWN)
    b.fillRect(2, 2, 1, 2, C_YELLOW)
    b.fillRect(5, 2, 1, 2, C_YELLOW)
    return b
}

// Each creature fires a different projectile in its retaliation.
function makeBullet(id: number): Image {
    let b: Image = null
    if (id == 0) {
        b = image.create(3, 9)        // thrown spear
        b.fill(C_SKY)
        b.setPixel(1, 0, C_WHITE)
    } else if (id == 1) {
        b = image.create(5, 5)        // snapping bite
        b.fill(C_ORANGE)
        b.setPixel(0, 0, 0)
        b.setPixel(4, 0, 0)
        b.setPixel(0, 4, 0)
        b.setPixel(4, 4, 0)
    } else {
        b = image.create(5, 5)        // cold wisp
        b.fill(C_WHITE)
        b.setPixel(0, 0, 0)
        b.setPixel(4, 0, 0)
        b.setPixel(0, 4, 0)
        b.setPixel(4, 4, 0)
        b.setPixel(2, 2, C_SKY)
    }
    return b
}



// 5. DRAWING HELPERS
//    Every map is painted onto the global image `bg`. Walls are rectangles
//    stored in the `walls` list, so what you see is what you collide with.

// Scatter `count` single pixels of one colour inside a rectangle.
function speckle(x: number, y: number, w: number, h: number, col: number, count: number) {
    for (let i = 0; i < count; i++) {
        bg.setPixel(randint(x, x + w - 1), randint(y, y + h - 1), col)
    }
}

// Checkerboard dither: soft shadows and glows using only 16 colours.
function shade(x: number, y: number, w: number, h: number, col: number) {
    for (let i = 0; i < w; i++) {
        for (let j = 0; j < h; j++) {
            if ((i + j) % 2 == 0) {
                bg.setPixel(x + i, y + j, col)
            }
        }
    }
}

// Fill a rectangle with rows of bricks.
function bricks(x: number, y: number, w: number, h: number, base: number, mortar: number) {
    bg.fillRect(x, y, w, h, base)
    for (let r = 0; r * 6 < h; r++) {
        let ry = y + r * 6
        let rowH = Math.min(6, y + h - ry)
        bg.fillRect(x, ry, w, 1, mortar)
        let off = 0
        if (r % 2 == 1) {
            off = 5
        }
        for (let bx = x + off; bx < x + w; bx += 10) {
            bg.fillRect(bx, ry, 1, rowH, mortar)
        }
    }
}

// A brick block that is also a wall.
function wallBlock(x: number, y: number, w: number, h: number, base: number, mortar: number) {
    bricks(x, y, w, h, base, mortar)
    bg.drawRect(x, y, w, h, C_BLACK)
    walls.push([x, y, w, h])
}

// A plain block that is also a wall.
function solid(x: number, y: number, w: number, h: number, col: number, edge: number) {
    bg.fillRect(x, y, w, h, col)
    bg.drawRect(x, y, w, h, edge)
    walls.push([x, y, w, h])
}

// Walls everywhere except a horizontal strip (top..bottom) of road.
function corridor(top: number, bottom: number) {
    walls.push([0, 0, 160, top])
    walls.push([0, bottom, 160, 120 - bottom])
}

// A 10x10 marble pillar (a wall).
function pillar(x: number, y: number) {
    bg.fillRect(x, y, 10, 10, C_TAN)
    bg.fillRect(x, y, 2, 10, C_WHITE)       // lit side
    bg.fillRect(x + 7, y, 3, 10, C_LILAC)   // shaded side
    bg.fillRect(x, y, 10, 2, C_PLUM)        // capital
    bg.fillRect(x, y + 8, 10, 2, C_PLUM)    // base
    bg.drawRect(x, y, 10, 10, C_BLACK)
    shade(x - 1, y + 10, 12, 3, C_PLUM)     // floor shadow
    walls.push([x, y, 10, 10])
}

// A wall torch with a warm glow around it.
function torch(x: number, y: number) {
    shade(x - 6, y - 4, 14, 16, C_ORANGE)   // glow first, so the torch sits on top
    bg.fillRect(x, y + 5, 2, 6, C_BROWN)
    bg.fillRect(x - 1, y + 4, 4, 2, C_BLACK)
    bg.fillRect(x, y, 2, 4, C_ORANGE)
    bg.fillRect(x, y + 1, 2, 2, C_YELLOW)
    bg.setPixel(x, y - 1, C_YELLOW)
}

// A throne on a back wall.
function drawThrone(x: number, y: number) {
    bg.fillRect(x, y, 18, 15, C_YELLOW)
    bg.drawRect(x, y, 18, 15, C_BROWN)
    bg.fillRect(x + 3, y + 7, 12, 8, C_RED)     // cushion
    bg.fillRect(x, y + 7, 3, 8, C_ORANGE)       // arms
    bg.fillRect(x + 15, y + 7, 3, 8, C_ORANGE)
    bg.setPixel(x + 2, y - 1, C_YELLOW)         // finials
    bg.setPixel(x + 9, y - 1, C_YELLOW)
    bg.setPixel(x + 15, y - 1, C_YELLOW)
    bg.fillRect(x + 7, y + 2, 4, 3, C_RED)      // jewel
}

// A hanging banner with a gold emblem.
function banner(x: number, y: number, w: number, h: number) {
    bg.fillRect(x, y, w, h, C_RED)
    bg.fillRect(x, y, w, 1, C_YELLOW)
    bg.fillRect(x + Math.idiv(w, 2) - 1, y + 3, 3, 3, C_YELLOW)
    bg.fillRect(x + Math.idiv(w, 2), y + 6, 1, 2, C_YELLOW)
    bg.setPixel(x, y + h - 1, 0)
    bg.setPixel(x + w - 1, y + h - 1, 0)
}

// A tall candle stand.
function candles(x: number, y: number) {
    bg.fillRect(x, y + 3, 2, 8, C_BROWN)
    bg.fillRect(x - 1, y + 10, 4, 1, C_BROWN)
    bg.fillRect(x, y + 1, 2, 2, C_WHITE)
    bg.setPixel(x, y, C_YELLOW)
    bg.setPixel(x + 1, y - 1, C_ORANGE)
    shade(x - 4, y - 3, 10, 8, C_YELLOW)
}

// One tree (16 wide, 17 tall) with a sunlit side and a shaded side.
function drawTree(x: number, y: number) {
    bg.fillRect(x + 6, y + 10, 4, 7, C_BROWN)     // trunk
    bg.fillRect(x + 9, y + 10, 1, 7, C_PLUM)
    bg.fillRect(x + 3, y, 10, 1, C_PLUM)          // outline
    bg.fillRect(x + 1, y + 1, 14, 10, C_TEAL)     // leaves
    bg.fillRect(x + 2, y + 11, 12, 1, C_PLUM)
    bg.fillRect(x + 2, y + 2, 5, 4, C_GREEN)      // sunlit leaves
    bg.setPixel(x + 4, y + 7, C_GREEN)
    bg.setPixel(x + 11, y + 3, C_GREEN)
    shade(x + 8, y + 7, 6, 4, C_PLUM)             // shadow side
}

// Bands of trees. One big wall covers the whole band.
function forestBand(y: number, rows: number) {
    for (let r = 0; r < rows; r++) {
        let off = 0
        if (r % 2 == 1) {
            off = 8
        }
        for (let x = -8; x < 160; x += 16) {
            drawTree(x + off, y + r * 16)
        }
    }
    walls.push([0, y, 160, rows * 16])
}

// A small flower.
function flower(x: number, y: number, col: number) {
    bg.setPixel(x, y, C_YELLOW)
    bg.setPixel(x - 1, y, col)
    bg.setPixel(x + 1, y, col)
    bg.setPixel(x, y - 1, col)
    bg.setPixel(x, y + 1, C_GREEN)
}

// A signpost.
function signPost(x: number, y: number) {
    bg.fillRect(x - 1, y, 2, 8, C_BROWN)
    bg.fillRect(x - 6, y - 6, 12, 7, C_TAN)
    bg.drawRect(x - 6, y - 6, 12, 7, C_BROWN)
    bg.fillRect(x - 4, y - 4, 8, 1, C_BROWN)
    bg.fillRect(x - 4, y - 2, 5, 1, C_BROWN)
}

// Cobblestones: a base colour with rows of stones outlined in `line`.
function cobbles(x: number, y: number, w: number, h: number, base: number, line: number) {
    bg.fillRect(x, y, w, h, base)
    for (let r = 0; r * 4 < h; r++) {
        let ry = y + r * 4
        bg.fillRect(x, ry, w, 1, line)
        let off = 0
        if (r % 2 == 1) {
            off = 3
        }
        for (let cx = x + off; cx < x + w; cx += 6) {
            bg.fillRect(cx, ry, 1, Math.min(4, y + h - ry), line)
        }
    }
}

// A cottage with timber framing, shingled roof, shutters and a flower box.
function house(x: number, y: number, w: number, h: number, roof: number, wall: number) {
    bg.fillRect(x, y + 8, w, h - 8, wall)                  // plaster walls
    bg.fillRect(x, y + 8, 2, h - 8, C_BROWN)               // timber posts
    bg.fillRect(x + w - 2, y + 8, 2, h - 8, C_BROWN)
    bg.fillRect(x, y + 13, w, 1, C_BROWN)                  // beam
